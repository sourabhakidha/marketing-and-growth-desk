{
  "name": "akidha-marketing-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Akidha Marketing Desk — internal marketing & growth platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm run test && npm run check:migrations && npm run check:secrets",
    "test:db": "bash scripts/test-db.sh",
    "member:create": "node --env-file=.env.local scripts/create-member.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
