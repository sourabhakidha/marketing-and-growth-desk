# Copy to .env.local for local development. NEVER commit real values.
# Netlify: set the same names under Site configuration → Environment variables.

# --- Browser (bundled into the frontend; must be PUBLIC values only) ---------
# Project URL and the *publishable* (anon) key. These are safe to expose:
# all access is enforced by RLS in the marketing_os schema.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (Netlify Functions; never prefix with VITE_) ---------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Phase 4 (AI). Leave empty until then; the app reports "not configured".
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Local admin script only (scripts/create-member.mjs) --------------------
# Bypasses RLS across the WHOLE shared project. Keep it on the admin's machine
# in .env.local. Do NOT add it to Netlify.
SUPABASE_SERVICE_ROLE_KEY=
